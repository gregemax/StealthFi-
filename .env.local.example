# Sui keypair for signing Ika dWallet DKG transactions on testnet.
#
# How to generate and fund:
#   1. Run: npx tsx scripts/fundKeypair.ts
#      This prints a new address and faucet link.
#   2. Visit https://faucet.sui.io and fund the address with test SUI + IKA.
#   3. Copy the printed secret key (Bech32 "suiprivkey1..." format) below.
#   4. Rename this file to .env.local
#
# WARNING: Never commit .env.local to git.
NEXT_PUBLIC_SUI_PRIVATE_KEY=
